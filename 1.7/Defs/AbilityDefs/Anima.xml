<?xml version="1.0" encoding="UTF-8"?>
<Defs>
	<!-- Level 1 -->
	<VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
		<defName>VPE_AnimattuneSTNL</defName>
		<label>Animattunement</label>
		<description>Passive upgrade: Unlocking this ability will automatically apply its effects.\n\nEvery hour, the anima grass located in the user's vicinity will grow by 10% of their psychic sensitivity.\n\nUnlocks the natural meditation type if the Animancer does not possess it, allowing them to meditate at the anima tree to produce grass.</description>
		<iconPath>UI_Anima/Abilities/Attune</iconPath>
		<abilityClass>SentinelFramework_STNL.Ability_PassiveGiver</abilityClass>
		<goodwillImpact>-100</goodwillImpact>
		<targetMode>Self</targetMode>
		<castTime>30</castTime>
		<range>12.9</range>
		<targetingParameters>
			<canTargetLocations>False</canTargetLocations>
			<canTargetSelf>True</canTargetSelf>
			<canTargetAnimals>false</canTargetAnimals>
			<canTargetPawns>True</canTargetPawns>
			<canTargetHumans>True</canTargetHumans>
			<canTargetMechs>false</canTargetMechs>
		</targetingParameters>
		<castSound>PsychicShockLanceCast</castSound>
		<modExtensions>
			<li Class="VanillaPsycastsExpanded.AbilityExtension_Psycast">
				<path>VPE_AnimaSTNL</path>
				<level>1</level>
				<order>1</order>
				<psyfocusCost>0.3</psyfocusCost>
				<entropyGain>35</entropyGain>
			</li>
			<li Class="SentinelFramework_STNL.Ability_PassiveModExt">
				<hediffsToAdd>
					<li>AnimaAttunedSTNL</li>
				</hediffsToAdd>
			</li>
		</modExtensions>
	</VEF.Abilities.AbilityDef>
	<VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
		<defName>VPE_AnimameditateSTNL</defName>
		<label>Animeditation</label>
		<description>Allows the user to resonate with ambient anima energy, causing them to regenerate missing psyfocus.\n\nThe amount of psychic experience awarded by this ability scales with the amount of anima grass in the region, reaching 100% experience gain at 20 anima grass.</description>
		<iconPath>UI_Anima/Abilities/Meditate</iconPath>
		<abilityClass>VPE_Anima.Ability_Animeditation</abilityClass>
		<targetMode>Self</targetMode>
		<castTime>600</castTime>
		<castSound>VPE_TimeskipMeditation_Cast</castSound>
		<cooldownTime>180000</cooldownTime>
		<showUndrafted>true</showUndrafted>
		<modExtensions>
			<li Class="VanillaPsycastsExpanded.AbilityExtension_Psycast">
				<path>VPE_AnimaSTNL</path>
				<level>2</level>
				<order>2</order>
				<psyfocusCost>0</psyfocusCost>
				<entropyGain>0</entropyGain>
				<prerequisites>
					<li>VPE_AnimattuneSTNL</li>
				</prerequisites>
			</li>
		</modExtensions>
	</VEF.Abilities.AbilityDef>
	<!-- Level 3 -->
	<VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
		<defName>VPE_SummonmoteSTNL</defName>
		<label>Anima mote</label>
		<description>Psychically manifest a mote of anima energy, allowing any psycaster to convert it to 25% psyfocus.\n\nEnabling autocasting will automatically produce motes once the Animancer can afford the cost.</description>
		<iconPath>Things/Item/animamoteSTNL/animamoteSTNL</iconPath>
		<castTime>500</castTime>
		<range>6.9</range>
		<targetMode>Location</targetMode>
		<abilityClass>SentinelFramework_STNL.Ability_ItemSpawner</abilityClass>
		<needsTicking>true</needsTicking>
		<!-- <chance>0</chance> -->
		<showUndrafted>true</showUndrafted>
		<modExtensions>
			<li Class="VanillaPsycastsExpanded.AbilityExtension_Psycast">
				<path>VPE_AnimaSTNL</path>
				<level>3</level>
				<order>2</order>
				<psyfocusCost>0.25</psyfocusCost>
				<entropyGain>45</entropyGain>
				<prerequisites>
					<li>VPE_AnimameditateSTNL</li>
				</prerequisites>
			</li>
			<li Class="VEF.Abilities.AbilityExtension_EffecterOnTarget">
				<effecterDef>Skip_ExitNoDelay</effecterDef>
				<maintainForTicks>600</maintainForTicks>
				<scale>1</scale>
			</li>
			<li Class="SentinelFramework_STNL.Ability_ItemSpawnerModExt">
				<thingDef>AnimaMoteSTNL</thingDef>
				<count>1</count>
			</li>
		</modExtensions>
	</VEF.Abilities.AbilityDef>
	<!-- Level 4 -->
	<VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
		<defName>VPE_AnimaMindSTNL</defName>
		<label>Animind</label>
		<description>Passive upgrade: Unlocking this ability will automatically apply its effects.\n\nAllows for passive resonance with the anima grass in the region. Drastically increases psychic sensitivity of the user the more anima grass is in their vicinity.</description>
		<iconPath>UI_Anima/Abilities/Mind</iconPath>
		<abilityClass>SentinelFramework_STNL.Ability_PassiveGiver</abilityClass>
		<goodwillImpact>-100</goodwillImpact>
		<targetMode>Self</targetMode>
		<castTime>30</castTime>
		<range>12.9</range>
		<targetingParameters>
			<canTargetLocations>False</canTargetLocations>
			<canTargetSelf>True</canTargetSelf>
			<canTargetAnimals>false</canTargetAnimals>
			<canTargetPawns>True</canTargetPawns>
			<canTargetHumans>True</canTargetHumans>
			<canTargetMechs>false</canTargetMechs>
		</targetingParameters>
		<castSound>PsychicShockLanceCast</castSound>
		<modExtensions>
			<li Class="VanillaPsycastsExpanded.AbilityExtension_Psycast">
				<path>VPE_AnimaSTNL</path>
				<level>4</level>
				<order>1</order>
				<psyfocusCost>0.3</psyfocusCost>
				<entropyGain>35</entropyGain>
				<prerequisites>
					<li>VPE_SummonmoteSTNL</li>
				</prerequisites>
			</li>
			<li Class="SentinelFramework_STNL.Ability_PassiveModExt">
				<hediffsToAdd>
					<li>AnimaAttunedSTNL</li>
				</hediffsToAdd>
			</li>
		</modExtensions>
	</VEF.Abilities.AbilityDef>
	<!-- Level 5 -->
	<VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
		<defName>VPE_AnimaVertigoSTNL</defName>
		<label>Anima vertigo</label>
		<description>Generate an overwhelming feeling of vertigo in everyone near the target point. Considered an overt act of aggression.</description>
		<iconPath>UI_Anima/Abilities/Vertigo</iconPath>
		<abilityClass>VEF.Abilities.Ability_Blank</abilityClass>
		<castTime>60</castTime>
		<durationTime>7500</durationTime>
		<range>20</range>
		<radius>5.5</radius>
		<targetMode>Location</targetMode>
		<hasAoE>true</hasAoE>
		<targetingParametersForAoE>
			<canTargetSelf>True</canTargetSelf>
			<canTargetHumans>True</canTargetHumans>
			<canTargetMechs>False</canTargetMechs>
			<canTargetAnimals>True</canTargetAnimals>
			<neverTargetIncapacitated>False</neverTargetIncapacitated>
		</targetingParametersForAoE>
		<goodwillImpact>-75</goodwillImpact>
		<modExtensions>
			<li Class="VanillaPsycastsExpanded.AbilityExtension_Psycast">
				<path>VPE_AnimaSTNL</path>
				<level>5</level>
				<order>2</order>
				<psyfocusCost>0.06</psyfocusCost>
				<entropyGain>65</entropyGain>
				<psychic>true</psychic>
				<prerequisites>
					<li>VPE_AnimaMindSTNL</li>
				</prerequisites>
			</li>
			<li Class="VEF.Abilities.AbilityExtension_Hediff">
				<hediff>PsychicVertigo</hediff>
			</li>
		</modExtensions>
	</VEF.Abilities.AbilityDef>
	<VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
		<defName>VPE_SummonWispSTNL</defName>
		<label>Anima wisp</label>
		<description>Psychically manifest a wisp of Anima energy, allowing any psycaster to convert it to 100% psyfocus.\n\nEnabling autocasting will automatically produce wisps once the Animancer can afford the cost.</description>
		<iconPath>Things/Item/animawispSTNL/animawispSTNL</iconPath>
		<castTime>500</castTime>
		<durationTime>300000</durationTime>
		<range>6.9</range>
		<targetMode>Location</targetMode>
		<abilityClass>SentinelFramework_STNL.Ability_ItemSpawner</abilityClass>
		<needsTicking>true</needsTicking>
		<!-- <chance>0</chance> -->
		<showUndrafted>true</showUndrafted>
		<modExtensions>
			<li Class="VanillaPsycastsExpanded.AbilityExtension_Psycast">
				<path>VPE_AnimaSTNL</path>
				<level>5</level>
				<order>2</order>
				<psyfocusCost>0.90</psyfocusCost>
				<entropyGain>45</entropyGain>
				<prerequisites>
					<li>VPE_AnimaMindSTNL</li>
				</prerequisites>
			</li>
			<li Class="VEF.Abilities.AbilityExtension_EffecterOnTarget">
				<effecterDef>Skip_ExitNoDelay</effecterDef>
				<maintainForTicks>600</maintainForTicks>
				<scale>1</scale>
			</li>
			<li Class="SentinelFramework_STNL.Ability_ItemSpawnerModExt">
				<thingDef>AnimaWispSTNL</thingDef>
				<count>1</count>
			</li>
		</modExtensions>
	</VEF.Abilities.AbilityDef>
	<!-- Level 6 -->
	<VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
		<defName>VPE_SummonpsylinkSTNL</defName>
		<label>Animalink</label>
		<description>Psychically manifest an Animalink by consuming at least 20 mature anima grass in the region. Animalinks allow another person to develop psychic powers, and will increase the level of psycasters who use it.\n\nThe amount of Animalinks created by this ability scales with the user's psychic sensitivity, spawning up to a maximum of three links in a single use.</description>
		<iconPath>Things/Item/animalinkSTNL/animalinkSTNL</iconPath>
		<castTime>500</castTime>
		<range>6.9</range>
		<targetMode>Location</targetMode>
		<abilityClass>VPE_Anima.Ability_Animalink</abilityClass>
		<needsTicking>true</needsTicking>
		<!-- <chance>0</chance> -->
		<showUndrafted>true</showUndrafted>
		<modExtensions>
			<li Class="VanillaPsycastsExpanded.AbilityExtension_Psycast">
				<path>VPE_AnimaSTNL</path>
				<level>6</level>
				<order>2</order>
				<psyfocusCost>0.75</psyfocusCost>
				<entropyGain>500</entropyGain>
				<prerequisites>
					<li>VPE_SummonWispSTNL</li>
					<li>VPE_AnimaVertigoSTNL</li>
				</prerequisites>
			</li>
			<li Class="VEF.Abilities.AbilityExtension_Spawn">
				<thing>PsychicAmplifierAnimaSTNL</thing>
			</li>
			<li Class="VEF.Abilities.AbilityExtension_EffecterOnTarget">
				<effecterDef>Skip_ExitNoDelay</effecterDef>
				<maintainForTicks>600</maintainForTicks>
				<scale>1</scale>
			</li>
		</modExtensions>
	</VEF.Abilities.AbilityDef>
	<VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
		<defName>VPE_AnimaReapSTNL</defName>
		<label>Anima reap</label>
		<description>Forcibly absorbs the target creature's essence, resulting in the target perishing instantly and the user becoming empowered by this newfound source of energy, additionally produces 5 anima grass around a random anima tree in the region.</description>
		<iconPath>UI_Anima/Abilities/Reap</iconPath>
		<abilityClass>VPE_Anima.Ability_AnimaReap</abilityClass>
		<castTime>120</castTime>
		<targetMode>Pawn</targetMode>
		<range>14.9</range>
		<needsTicking>true</needsTicking>
		<goodwillImpact>-100</goodwillImpact>
		<castSound>DeathAcidifier</castSound>
		<targetingParameters>
			<canTargetLocations>False</canTargetLocations>
			<canTargetSelf>False</canTargetSelf>
			<canTargetAnimals>True</canTargetAnimals>
			<canTargetPawns>True</canTargetPawns>
			<canTargetHumans>True</canTargetHumans>
			<canTargetMechs>True</canTargetMechs>
		</targetingParameters>
		<modExtensions>
			<li Class="VanillaPsycastsExpanded.AbilityExtension_Psycast">
				<path>VPE_AnimaSTNL</path>
				<level>6</level>
				<order>1</order>
				<psyfocusCost>0.75</psyfocusCost>
				<entropyGain>75</entropyGain>
				<prerequisites>
					<li>VPE_SummonWispSTNL</li>
					<li>VPE_AnimaVertigoSTNL</li>
				</prerequisites>
			</li>
			<li Class="VEF.Abilities.AbilityExtension_EffecterOnTarget">
				<effecterDef>Skip_ExitNoDelay</effecterDef>
				<maintainForTicks>30</maintainForTicks>
				<scale>2</scale>
			</li>
		</modExtensions>
	</VEF.Abilities.AbilityDef>
	<VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
		<defName>VPE_AnimaBansheeSTNL</defName>
		<label>Anima banshee</label>
		<description>Generate an overwhelming rush of fear in everyone near the target point. Considered an overt act of aggression.</description>
		<iconPath>UI_Anima/Abilities/Banshee</iconPath>
		<abilityClass>VanillaPsycastsExpanded.Ability_BerserkPulse</abilityClass>
		<castTime>60</castTime>
		<durationTime>1500</durationTime>
		<range>20</range>
		<radius>5.5</radius>
		<targetMode>Location</targetMode>
		<hasAoE>true</hasAoE>
		<targetingParametersForAoE>
			<canTargetSelf>True</canTargetSelf>
			<canTargetHumans>True</canTargetHumans>
			<canTargetMechs>True</canTargetMechs>
			<canTargetAnimals>True</canTargetAnimals>
			<neverTargetIncapacitated>True</neverTargetIncapacitated>
		</targetingParametersForAoE>
		<goodwillImpact>-75</goodwillImpact>
		<modExtensions>
			<li Class="VanillaPsycastsExpanded.AbilityExtension_Psycast">
				<path>VPE_AnimaSTNL</path>
				<level>6</level>
				<order>3</order>
				<psyfocusCost>0.49</psyfocusCost>
				<entropyGain>65</entropyGain>
				<psychic>true</psychic>
				<prerequisites>
					<li>VPE_SummonWispSTNL</li>
					<li>VPE_AnimaVertigoSTNL</li>
				</prerequisites>
			</li>
			<li Class="VanillaPsycastsExpanded.AbilityExtension_GiveMentalState">
				<stateDef>PanicFlee</stateDef>
				<durationMultiplier>PsychicSensitivity</durationMultiplier>
			</li>
		</modExtensions>
	</VEF.Abilities.AbilityDef>
</Defs>